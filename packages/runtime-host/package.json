    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-ts-webcompat-resolver": "^1.0.1",
    "prettier": "^3.6.2",
    "shx": "^0.3.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
